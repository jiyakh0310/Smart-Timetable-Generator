# Copy this file to ".env" in the project root and fill in real values.
# ".env" is git-ignored. NEVER commit real secrets or passwords.

APP_ENV=development

# Generate each with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-different-long-random-value
JWT_EXPIRES_HOURS=8

# MySQL - create the database and a dedicated user in MySQL Workbench first (see README)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_timetable
DB_USER=timetable_app
DB_PASSWORD=replace-with-your-mysql-app-password

# Optional: a full SQLAlchemy URL overrides the DB_* values above
# DATABASE_URL=
#   A provider URL such as  mysql://USER:PASSWORD@HOST:PORT/DBNAME?ssl-mode=REQUIRED  is accepted; it is run through PyMySQL
#   automatically and the ssl-mode parameter is translated into the TLS settings below.

# TLS for a remote / managed MySQL (Aiven, ...). Production refuses a remote database without one of these.
#   DB_SSL_CA_PEM  the provider's CA certificate text (BEGIN/END CERTIFICATE) -> encrypted and verified (recommended)
#   DB_SSL_CA      or a path to that certificate file (e.g. a Render Secret File)
#   DB_SSL_MODE    REQUIRED        encrypted, certificate NOT verified (use only until the CA is set)
#                  VERIFY_CA       encrypted, certificate chain verified against your CA, host name not checked
#                  VERIFY_IDENTITY encrypted, chain AND host name verified (the default whenever a CA is supplied)
#   If a deployed app answers /api/v1/health with details.reason "tls_hostname_mismatch", set DB_SSL_MODE=VERIFY_CA.
#   Diagnose from a shell:  flask --app run db-check   (read-only; prints the redacted reason and what to change)
# DB_SSL_CA_PEM=
# DB_SSL_CA=
# DB_SSL_MODE=

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Optional: password for the DEVELOPMENT-ONLY demo accounts created by "seed-demo"
# (defaults to Demo@12345 when unset)
# DEMO_PASSWORD=

# Copy this file to ".env" in the project root and fill in real values.
# ".env" is git-ignored. NEVER commit real secrets or passwords.

APP_ENV=development

# Generate each with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-different-long-random-value
JWT_EXPIRES_HOURS=8

# MySQL - create the database and a dedicated user in MySQL Workbench first (see README)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_timetable
DB_USER=timetable_app
DB_PASSWORD=replace-with-your-mysql-app-password

# Optional: a full SQLAlchemy URL overrides the DB_* values above
# DATABASE_URL=

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Optional: password for the DEVELOPMENT-ONLY demo accounts created by "seed-demo"
# (defaults to Demo@12345 when unset)
# DEMO_PASSWORD=
